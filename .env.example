APP_NAME="BEACON OSAS Portal"
APP_KEY=
APP_URL=http://127.0.0.1:8081
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_DEMO_MODE=true

# ============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST — update these before going live:
#   1. APP_ENV=production          (disables debug output; enforced in code)
#   2. APP_DEBUG=false             (stack traces leak paths/SQL/config)
#   3. APP_URL=https://<real-host> (used in password-reset email links —
#                                  prevents host-header injection)
#   4. SESSION_SECURE=true         (session + remember-me cookies over HTTPS only)
#   5. APP_DEMO_MODE=false         (hides demo hints from the login page)
#   6. DB_USERNAME/DB_PASSWORD     (dedicated least-privilege PostgreSQL user, NOT postgres)
#   7. Generate a fresh APP_KEY:   php artisan key:generate
#   8. Never commit real credentials — .env.example must keep placeholders only
# ============================================================================

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=osas_beacon
DB_USERNAME=osas_beacon
DB_PASSWORD=secret

SESSION_NAME=beacon_session
SESSION_DRIVER=file
CACHE_STORE=file
SESSION_SECURE=false

MAIL_MAILER=log
MAIL_FROM_ADDRESS=osas.support@uc.edu.ph
MAIL_FROM_NAME="BEACON OSAS Portal"

SEED_COORDINATOR_PASSWORD=
SEED_STUDENT_PASSWORD=
SEED_ADMIN_PASSWORD=

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_DEFAULT_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_REQUEST_TIMEOUT=60
