APP_NAME="BEACON OSAS Portal"
APP_KEY=
APP_URL=http://127.0.0.1:8081
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_DEMO_MODE=true

# ============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST — update these before going live:
#   1. APP_ENV=production          (disables debug output; enforced in code)
#   2. APP_DEBUG=false             (stack traces leak paths/SQL/config)
#   3. APP_URL=https://<real-host> (used in password-reset email links —
#                                  prevents host-header injection)
#   4. SESSION_SECURE=true         (session + remember-me cookies over HTTPS only)
#   5. APP_DEMO_MODE=false         (hides demo hints from the login page)
#   6. DB_USERNAME/DB_PASSWORD     (dedicated least-privilege PostgreSQL user, NOT postgres)
#   7. Generate a fresh APP_KEY:   php artisan key:generate
#   8. Never commit real credentials — .env.example must keep placeholders only
# ============================================================================

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=osas_beacon
DB_USERNAME=osas_beacon
DB_PASSWORD=secret
# Set to "require" on hosted PostgreSQL (e.g. Aiven), which rejects
# non-SSL connections. Local PostgreSQL works with the default "prefer".
# Aiven for PostgreSQL — copy these from the Aiven console:
#   service > Overview > Connection Information
#   Host format:   <service>-<project>.<region>.aivencloud.com
#   Port:          AIVEN ASSIGNS A RANDOM PORT (ours is 26572, NOT 5432).
#                  5432 is the usual default; 6432 is the pgbouncer pooler.
#                  Copy whatever the console shows — a stale 5432 will not connect.
#   Database:      defaultdb  (Aiven's default. There is NO "postgres" database.)
#   Username:      avnadmin    (Aiven's default admin user)
#   Password:      shown / resettable on the same page
# Use the direct port, NOT the 6432 pooler: PDO prepared statements and
# transactions (Laravel sessions, DB::transaction) misbehave through pgbouncer
# unless it runs in transaction pooling mode.
DB_SSLMODE=prefer

SESSION_NAME=beacon_session
# "database" stores sessions in the `sessions` table. Required for the
# single-active-session rule: a fresh login deletes the user's other session
# rows, so any previous device is invalid on its next request. It also
# survives redeploys on ephemeral disks (e.g. Render free tier), where file
# sessions are wiped on every restart, logging everyone out.
SESSION_DRIVER=database
CACHE_STORE=file
SESSION_SECURE=false

MAIL_MAILER=log
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
# Brevo SMTP username (e.g. xxxxxxxx@smtp-brevo.com)
MAIL_USERNAME=
# Brevo SMTP master key / password
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=carlosnath991@gmail.com
MAIL_FROM_NAME="BEACON OSAS Portal"
BREVO_API_KEY=

SEED_COORDINATOR_PASSWORD=
SEED_STUDENT_PASSWORD=
SEED_ADMIN_PASSWORD=

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_DEFAULT_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_REQUEST_TIMEOUT=60
